# .env.example — SeraphAID
# Copia este archivo como .env y completa los valores.
# El archivo .env NO debe subirse al repositorio (ya está en .gitignore).

# ── Provider de IA ─────────────────────────────────────────────────────
# Valores válidos: "rules" (sin IA), "openai", "anthropic"
# Si no configuras ninguna API key, el sistema funciona en modo "rules".
AI_PROVIDER=rules

# ── OpenAI ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Anthropic (Claude) ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── ElevenLabs TTS (desactivado en esta fase) ──────────────────────────
# ELEVEN_API_KEY=
